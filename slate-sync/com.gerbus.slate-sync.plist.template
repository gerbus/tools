<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.gerbus.slate-sync</string>
  <key>ProgramArguments</key><array>
    <string>__HOME__/bin/sync-slate.sh</string>
  </array>
  <key>WatchPaths</key><array>
    <string>__HOME__/.slate</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/slate-sync.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/slate-sync.log</string>
</dict></plist>
